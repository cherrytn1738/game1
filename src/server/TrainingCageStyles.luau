-- Looks for the fantasy (World 1) and futuristic (World 3) Training Ground cages (Blender
-- models in ServerStorage.RunwayAssets, generated by tools/blender/*_cage.py). FBX imports carry no colors, so every MeshPart is
-- styled here by name. Visual only: nothing here affects training.
--   color, material, transparency, shadow (false = no shadow)
--   light: a PointLight at the part ({color, range, brightness})
--   motion (animated on each client by TrainingStadiumClient):
--     spin = degrees/second about spinAxis (part-local: a Blender direction (x, y, z) is (-x, z, y),
--       since imported cages arrive turned a half turn)
--     bob = studs up and down, bobSpeed (radians/second), phase
--     sway = degrees of rocking about the part's base, swaySpeed, phase
--     pulse = glow pulses per second
-- effects: particle emitters in plate space, given in Blender coordinates via b(x, y, z).
-- tint: a color grade the client applies while its camera is inside the cage.
local Styles = {}

local function rgb(r, g, b) return Color3.fromRGB(r, g, b) end
local function b(x, y, z) return Vector3.new(x, z, -y) end -- Blender (x, y, z) to plate space
local function style(color, material, extra)
 local entry = extra or {}
 entry.color, entry.material = color, material
 return entry
end

