local MARBLE, GOLD = rgb(232, 232, 224), rgb(250, 196, 70)
local BARK, LEAF, LEAF_LIGHT, BLOSSOM = rgb(92, 61, 38), rgb(69, 140, 56), rgb(140, 191, 77), rgb(250, 158, 204)
